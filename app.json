{
  "expo": {
    "name": "FoodSnap",
    "slug": "minimal",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "minimal",
    "userInterfaceStyle": "automatic",
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FDF3E7"
      }
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FDF3E7"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}