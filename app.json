
{
  "expo": {
    "name": "FoodSnap",
    "slug": "minimal",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "minimal",
    "userInterfaceStyle": "automatic",
    "assetBundlePatterns": [
      "**/*"
    ],
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FDF3E7"
      }
    },
    "ios": {
      "supportsTablet": true
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FDF3E7"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
